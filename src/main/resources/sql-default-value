INSERT INTO dbo.breast_cancer_question
    (step_id, code, display_order, label_ar, label_en, control_type, is_required, is_disabled, prefill_source)
SELECT s.step_id, q.code, q.ord, q.label_ar, q.label_en, q.control_type, q.is_required,
       CASE WHEN q.prefill IS NULL THEN 0 ELSE 1 END, q.prefill
FROM #q q
JOIN dbo.breast_cancer_survey_step s ON s.version_id = @v AND s.step_no = q.step_no;

/* ---- special field settings ---- */
UPDATE qn SET max_length = 3
FROM dbo.breast_cancer_question qn JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id
WHERE s.version_id = @v AND qn.code = N'A1';

UPDATE qn SET max_length = 200, hint_ar = N'في حال اختيار "أسباب أخرى"', hint_en = N'If you selected "Other"'
FROM dbo.breast_cancer_question qn JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id
WHERE s.version_id = @v AND qn.code = N'A16_OTHER';

UPDATE qn SET is_multiline = 1, max_length = 1000
FROM dbo.breast_cancer_question qn JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id
WHERE s.version_id = @v AND qn.code = N'B26';

UPDATE qn SET is_sensitive = 1, max_length = 100,
       validation_regex = N'^[^@\s]+@[^@\s]+\.[^@\s]+$',
       validation_msg_ar = N'البريد الإلكتروني غير صحيح', validation_msg_en = N'Invalid email address'
FROM dbo.breast_cancer_question qn JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id
WHERE s.version_id = @v AND qn.code = N'B28_EMAIL';

UPDATE qn SET is_sensitive = 1, max_length = 8,
       validation_regex = N'^[0-9]{8}$',
       validation_msg_ar = N'يرجى إدخال رقم هاتف صحيح مكون من 8 أرقام', validation_msg_en = N'Please enter a valid 8-digit phone number'
FROM dbo.breast_cancer_question qn JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id
WHERE s.version_id = @v AND qn.code IN (N'B28_PHONE', N'B28_SMS', N'B28_WHATSAPP');

