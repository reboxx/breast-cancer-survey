INSERT INTO dbo.breast_cancer_question_option (question_id, value, text_ar, text_en, display_order, is_other)
SELECT qn.question_id, o.value, o.text_ar, o.text_en, o.ord, o.is_other
FROM #o o
JOIN dbo.breast_cancer_question qn ON qn.code = o.code
JOIN dbo.breast_cancer_survey_step s ON s.step_id = qn.step_id AND s.version_id = @v;

/* ---------- 6. Branching conditions ---------- */
-- Question-level: (dependent question, parent, operator, expected)
INSERT INTO dbo.breast_cancer_question_condition (question_id, step_id, parent_question_id, operator, expected_value)
SELECT dq.question_id, NULL, pq.question_id, c.op, c.expected
FROM (VALUES
        (N'B3',  N'B2',  N'EQUALS', N'1'),   -- mammogram reasons  if B2 = Yes
        (N'B4',  N'B2',  N'EQUALS', N'2'),   -- barriers           if B2 = No
        (N'B22', N'B21', N'EQUALS', N'1'),   -- booked via app     if aware
        (N'B24', N'B23', N'EQUALS', N'1')    -- how heard          if done via program
     ) c(dep, parent, op, expected)
JOIN dbo.breast_cancer_question dq ON dq.code = c.dep
JOIN dbo.breast_cancer_survey_step ds ON ds.step_id = dq.step_id AND ds.version_id = @v
JOIN dbo.breast_cancer_question pq ON pq.code = c.parent
JOIN dbo.breast_cancer_survey_step ps ON ps.step_id = pq.step_id AND ps.version_id = @v;

-- Step-level: whole step shown only when condition met
INSERT INTO dbo.breast_cancer_question_condition (question_id, step_id, parent_question_id, operator, expected_value)
SELECT NULL, s.step_id, pq.question_id, c.op, c.expected
FROM (VALUES
        ( 7, N'B5',  N'EQUALS', N'1'),   -- BSE Q6-9         if B5 = Yes
        ( 9, N'B10', N'EQUALS', N'1'),   -- detection method if diagnosed
        (17, N'B27', N'EQUALS', N'1')    -- contact details  if agreed
     ) c(step_no, parent, op, expected)
JOIN dbo.breast_cancer_survey_step s ON s.version_id = @v AND s.step_no = c.step_no
JOIN dbo.breast_cancer_question pq ON pq.code = c.parent
JOIN dbo.breast_cancer_survey_step ps ON ps.step_id = pq.step_id AND ps.version_id = @v;

DROP TABLE #q;
DROP TABLE #o;

COMMIT TRANSACTION;

/* ---------- Quick check ---------- */
SELECT s.step_no, s.section_code, COUNT(DISTINCT q.question_id) AS questions, COUNT(o.option_id) AS options
FROM dbo.breast_cancer_survey_step s
LEFT JOIN dbo.breast_cancer_question q ON q.step_id = s.step_id
LEFT JOIN dbo.breast_cancer_question_option o ON o.question_id = q.question_id
WHERE s.version_id = @v
GROUP BY s.step_no, s.section_code
ORDER BY s.step_no;